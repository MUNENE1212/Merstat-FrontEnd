# merstat-api — environment for the VPS copy of the API service.
#
# Copy to .env on the VPS and chmod 600. This file is the template only; the
# real values must never be committed.

# --- Where this service is reachable ---------------------------------------
# Only nginx proxies to this. Keep it on loopback so it has no public surface.
HOST=127.0.0.1
PORT=3011

# --- Origin allow-list (REQUIRED) -------------------------------------------
# Comma-separated. Both the form handler and the presign endpoint reject any
# request whose Origin is not on this list, and the presign endpoint will hand
# out anonymous R2 upload URLs if this is wrong. Add https://www.merstat.org
# and any preview host you use.
ALLOWED_ORIGINS=https://merstat.org

# --- Cloudflare Turnstile ---------------------------------------------------
# The secret half. Its test value 1x0000000000000000000000000000000AA makes
# every submission pass verification — never set it in production, or the form
# looks protected while accepting every bot.
TURNSTILE_SECRET_KEY=

# --- Cloudflare R2 (CV uploads) ---------------------------------------------
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_PUBLIC_BASE=https://uploads.merstat.org

# --- Form notifications -----------------------------------------------------
# Leave SMTP_HOST empty to record submissions to disk only. Set it to have
# each accepted submission emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FORM_FROM=website@merstat.org
FORM_NOTIFY_EMAIL=info@merstat.org
FORM_REPLY_TO=

# Where submissions are appended as JSONL. Survives releases.
FORM_SUBMISSIONS_DIR=/var/www/merstat/shared/form-submissions