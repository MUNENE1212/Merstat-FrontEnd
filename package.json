{
  "name": "merstat-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Merstat Development Limited marketing site. Built with Astro 5 + Sveltia CMS.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint . --ext .ts,.astro,.mjs",
    "lint:fix": "eslint . --ext .ts,.astro,.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:api": "node scripts/test-api.mjs",
    "api:start": "node api/server.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "images:optimise": "node scripts/optimise-hero.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.4.0",
    "astro": "^5.13.0",
    "schema-dts": "^1.1.2",
    "sharp": "^0.34.0",
    "web-vitals": "^4.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^15.14.0",
    "lightningcss": "^1.33.0",
    "pa11y-ci": "^3.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "nanoid": "^3.3.7"
  }
}
