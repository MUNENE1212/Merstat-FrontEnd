---
/**
 * <CaseStudyCard> — Card used on the results/methods page for the
 * Proofmap six-block case studies.
 */
interface Props {
  title: string;
  partnerDescriptor: string;
  sector: string;
  geography: string;
  year: number;
  href: string;
  snapshot: string;
}
const { title, partnerDescriptor, sector, geography, year, href, snapshot } = Astro.props;
---

<article class="case-card glass-card">
  <header>
    <p class="case-meta">
      <span class="badge">{sector}</span>
      <span class="badge badge--muted">{geography}</span>
      <span class="badge badge--muted">{year}</span>
    </p>
    <h3 class="case-title"><a href={href}>{title}</a></h3>
    <p class="case-partner">For {partnerDescriptor}.</p>
  </header>
  <p class="case-snapshot">{snapshot}</p>
  <p><a class="case-link" href={href}>Read the case study →</a></p>
</article>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .case-title {
    margin: 0;
    font-size: var(--fs-xl);
  }
  .case-title a {
    /* --color-accent scores 4.27:1 on the card surface (#2f5e84), below
       the 4.5:1 WCAG AA floor for body-size text. */
    color: var(--color-accent-text);
    text-decoration: none;
    /* WCAG 2.2 target size: as an inline link the hit area collapsed to
       the text line-height. inline-block + vertical padding clears the
       24px minimum without changing the visual layout. */
    display: inline-block;
    padding: var(--space-2) 0;
  }
  .case-title a:hover,
  .case-title a:focus-visible {
    text-decoration: underline;
  }
  .case-partner {
    color: var(--color-text-muted);
    margin: 0;
    font-style: italic;
  }
  .case-snapshot {
    margin: 0;
    line-height: var(--lh-normal);
  }
  .case-link {
    /* No accent tone clears WCAG AA on this card surface (#427090):
       #ffc300 measures 3.30:1 and #ffd866 3.86:1. Inverting instead —
       accent background with primary text — scores 7.84:1, and matches
       the .btn--primary treatment used elsewhere. */
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--color-accent);
    color: var(--color-text-inverse);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }
  .case-link:hover,
  .case-link:focus-visible {
    background: var(--color-accent-700);
    color: var(--color-text-inverse);
  }
</style>
