---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../utils/site';
---

<BaseLayout title={`Terms — ${SITE.name}`} description="Terms of use for the Merstat website.">
  <section class="section">
    <div class="container container-narrow">
      <h1>Terms of use</h1>
      <p class="prose"><em>Last updated: {new Date().toISOString().slice(0, 10)}.</em></p>

      <h2>About this site</h2>
      <p>
        This site is operated by Merstat Development Limited, registered in Kenya. Use of the site
        is subject to these terms.
      </p>

      <h2>Content</h2>
      <p>
        All content on this site is the property of Merstat Development Limited or its licensors.
        You may read, print, or share it for non-commercial purposes with attribution to Merstat.
      </p>

      <h2>No professional advice</h2>
      <p>
        Content on this site is provided for general information. It is not professional advice and
        does not create a client relationship between you and Merstat.
      </p>

      <h2>Liability</h2>
      <p>
        We aim to keep the site accurate and available but cannot guarantee it. We are not liable
        for losses arising from use of the site.
      </p>

      <h2>Governing law</h2>
      <p>These terms are governed by the laws of Kenya.</p>

      <h2>Contact</h2>
      <p>
        For questions about these terms, email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
