---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../utils/site';
---

<BaseLayout
  title={`Information security — ${SITE.name}`}
  description="How Merstat protects your information — security policies and practices."
>
  <section class="section">
    <div class="container container-narrow">
      <h1>Information security</h1>
      <p class="prose"><em>Last updated: {new Date().toISOString().slice(0, 10)}.</em></p>

      <h2>What we protect</h2>
      <p>Client data, partner data, employee data, and CVs of applicants.</p>

      <h2>How we protect it</h2>
      <ul>
        <li>HTTPS everywhere (HSTS preload, TLS 1.3).</li>
        <li>Strict content security policy on every page.</li>
        <li>Cloudflare Turnstile on every form to block spam and credential-stuffing.</li>
        <li>
          CVs are uploaded directly to Cloudflare R2 (encrypted, region-locked) via presigned URLs —
          they never touch our origin.
        </li>
        <li>No third-party trackers, ad networks, or social widgets.</li>
        <li>Quarterly access reviews; least-privilege access by default.</li>
      </ul>

      <h2>Incident response</h2>
      <p>
        We will notify affected parties within 72 hours of becoming aware of a personal data breach,
        in line with GDPR and the Kenya Data Protection Act.
      </p>

      <h2>Reporting a vulnerability</h2>
      <p>
        Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> with a description and reproduction steps.
        We will respond within 3 working days.
      </p>
    </div>
  </section>
</BaseLayout>
