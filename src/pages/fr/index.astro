---
/**
 * French home. Same pattern as the Swahili home.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../utils/site';
import { useTranslations, type Locale } from '../../i18n/utils';
import { organizationJsonLd, breadcrumbJsonLd } from '../../utils/jsonld';

const locale: Locale = 'fr';
const t = useTranslations(locale);
const breadcrumb = breadcrumbJsonLd([{ name: 'Accueil', url: `${SITE.url}/${locale}/` }]);
---

<BaseLayout
  title={`${SITE.name} — ${t('footer.tag')}`}
  description={SITE.description}
  locale={locale}
  jsonLd={[organizationJsonLd(), breadcrumb]}
>
  <section class="section">
    <div class="container" style="text-align: center;">
      <h1>{t('footer.tag')}</h1>
      <p class="prose" style="margin-inline: auto;">
        {SITE.description}
      </p>
      <p style="margin-top: var(--space-5);">
        <a class="btn btn--primary btn--lg" href="/services/">{t('cta.services')}</a>
        <a class="btn btn--ghost btn--lg" href="/contact/">{t('cta.contact')}</a>
      </p>
    </div>
  </section>
</BaseLayout>
