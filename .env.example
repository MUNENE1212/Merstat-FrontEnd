# Site URL — used by Astro to build canonical URLs, sitemap, OG tags.
SITE_URL=https://merstat.org

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Plausible Analytics (https://plausible.io)
PUBLIC_PLAUSIBLE_DOMAIN=merstat.org
PUBLIC_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js

# Cloudflare R2 (for CV uploads via Netlify Functions)
# https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=merstat-uploads
R2_REGION=auto
R2_PUBLIC_BASE=https://uploads.merstat.org

# Webhooks (for form notifications)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Search (Pagefind is local-only; no env vars needed)